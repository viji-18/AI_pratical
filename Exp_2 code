# Electricity Billing System
def calculate_bill(units):
    
   bill=0
   if units <=100:
      bill=units*1.50
   elif units <=200:
      bill = 100*1.50+(units-200)*2.50
   elif units<=500:
      bill = 100*1.50+200*2.50+(units-200)*4
   else:
      bill = 100 *1.50 + 200*2.50+300*4+(units-500)*6
   return bill
n=int(input("Enter no of coustmers:"))
for i in range (1,n+1):
   print(f"coustmer{i}")
   name = input("Enter the coustmer name:")
   units=int(input("enter total units consumed:"))
   bill = calculate_bill(units)
   print("coustmer name:",name)
   print("units consumed:",units)
   print("bill amount:Rs.",bill)
